# Twitch IRC credentials
# Generate a chat token at https://twitchapps.com/tmi/
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_CHANNEL=your_channel

# Logging level: DEBUG, INFO, WARNING, ERROR (defaults to INFO)
LOG_LEVEL=INFO

# Optional IRC overrides
TWITCH_IRC_HOST=irc.chat.twitch.tv
TWITCH_IRC_PORT=6697
TWITCH_IRC_TLS=true
TWITCH_USERNAME_COLOR=blue

# Optional timed self-promotion message (leave empty to disable)
SELF_PROMOTION_MESSAGE=

# Optional Spotify integration (leave blank to disable)
SPOTIFY_USERNAME=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost/
SPOTIFY_PLAYLIST_ID=
